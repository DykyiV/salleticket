# Local dev uses SQLite; the file will be created at prisma/dev.db on first migrate.
DATABASE_URL="file:./dev.db"

# JWT signing secret for auth sessions. Must be at least 16 characters.
# Generate a strong one with:  openssl rand -base64 48
JWT_SECRET="super-secret-key-12345"

# Bearer token protecting POST /api/cron/settlements (monthly settlement
# generation, triggered by .github/workflows/settlements.yml on the 7th).
# Generate a strong one with:  openssl rand -base64 48
CRON_SECRET="change-me-cron-secret"
