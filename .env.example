# Local dev uses SQLite; the file will be created at prisma/dev.db on first migrate.
DATABASE_URL="file:./dev.db"

# JWT signing secret for auth sessions. In production it must be at least
# 32 characters and must not be this example value (the server refuses).
# Generate a strong one with:  openssl rand -base64 48
JWT_SECRET="super-secret-key-12345"

# Bearer token protecting the cron endpoints: POST /api/cron/auto-reports
# (daily, .github/workflows/settlements.yml) and POST /api/cron/settlements.
# Generate a strong one with:  openssl rand -base64 48
CRON_SECRET="change-me-cron-secret"

# Online payments. Empty = test payments in development, OFF in production
# (the test provider would give away free tickets). A real provider
# (monobank) is not integrated yet. PAYMENT_PROVIDER="mock" together with
# ALLOW_MOCK_PAYMENTS="1" enables the test provider on a closed test server
# only — never on a live site.
PAYMENT_PROVIDER=""
ALLOW_MOCK_PAYMENTS=""

# Demo carriers (made-up buses, flights, trains in search results).
# On by default in development; in production only with "1" (tests/demo).
ENABLE_DEMO_CARRIERS=""

# Public address of the site, used in e-mails and in the QR codes of PDF
# tickets (no trailing slash). Empty = taken from the request.
SITE_URL=""

# Ticket e-mails (and finance reports). MAIL_PROVIDER: "resend" or "brevo";
# empty = nothing is sent and the site says mail is not connected yet.
# MAIL_API_KEY — the provider's API key. MAIL_FROM — sender on a domain
# verified with the provider, e.g. "Asol BUS <tickets@grandes-tour.com.ua>".
MAIL_PROVIDER=""
MAIL_API_KEY=""
MAIL_FROM=""
MAIL_REPLY_TO=""
