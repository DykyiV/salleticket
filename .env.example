# Local dev uses SQLite; the file will be created at prisma/dev.db on first migrate.
DATABASE_URL="file:./dev.db"

# JWT signing secret for auth sessions. Must be at least 16 characters.
# Generate a strong one with:  openssl rand -base64 48
JWT_SECRET="super-secret-key-12345"

# Bearer token protecting the cron endpoints: POST /api/cron/auto-reports
# (daily, .github/workflows/settlements.yml) and POST /api/cron/settlements.
# Generate a strong one with:  openssl rand -base64 48
CRON_SECRET="change-me-cron-secret"

# Optional social sign-in. The buttons are always shown. Without these keys
# the provider sends the user back to /login with an error — it does not
# create a fake session.
# Redirect URLs to register with each provider:
#   {origin}/api/auth/oauth/google/callback
#   {origin}/api/auth/oauth/apple/callback
#   {origin}/api/auth/oauth/facebook/callback
#   {origin}/api/auth/oauth/instagram/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
# PKCS8 .p8 contents. Newlines can be written as \n.
APPLE_PRIVATE_KEY=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
