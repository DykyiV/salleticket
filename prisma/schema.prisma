// Asol BUS — Prisma schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  AGENT
  ADMIN
  SUPER_ADMIN
}

enum TicketStatus {
  RESERVED
  PAID_ONLINE
  PAID_CASH
  CANCELLED
  REFUNDED
}

enum AgeCategory {
  CHILD_0_4
  CHILD_5_12
  ADULT
  SENIOR_60
}

enum PromoType {
  PERCENT
  FIXED
}

enum SeatStatus {
  AVAILABLE
  BOOKED
}

enum CommissionType {
  FIXED
  PERCENT
}

/// How a ticket was actually paid for — separate from TicketStatus's
/// PAID_ONLINE/PAID_CASH (which only says "paid" vs "how"), this says *who
/// collected the money*: the platform (ONLINE), the booking agent in cash
/// (CASH_TO_AGENT), or the carrier's driver/office at boarding
/// (CASH_TO_CARRIER). Staff set this explicitly via /staff/tickets; it's
/// what /admin/reports splits revenue by.
enum PaymentMethod {
  ONLINE
  CASH_TO_AGENT
  CASH_TO_CARRIER
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Commission this user earns per ticket they book as staff
  /// (bookedByUserId on Ticket). Only meaningful for AGENT/ADMIN accounts;
  /// null means "no commission configured".
  commissionType  CommissionType?
  commissionValue Float?

  /// Fine-grained access to the /staff/** area, for AGENT accounts only —
  /// ADMIN/SUPER_ADMIN always have full access regardless of these flags
  /// (see lib/auth/staffPermissions.ts). Default false: an agent gets none
  /// of this until an admin explicitly grants it on /admin/agents.
  canAccessStaffTickets Boolean @default(false)
  canAccessStaffTrips   Boolean @default(false)
  canMarkPayments       Boolean @default(false)

  /// This user's own referral code (lazily provisioned — see
  /// lib/referrals.ts). Sharing /register?ref=<code> credits referredBy.
  referralCode          String? @unique
  referredByUserId      String?
  referredBy            User?   @relation("Referrals", fields: [referredByUserId], references: [id], onDelete: SetNull)
  referrals             User[]  @relation("Referrals")
  /// Set once the referrer's reward has been granted for this user's first
  /// paid booking, so it's never granted twice.
  referralRewardGranted Boolean @default(false)

  tickets       Ticket[]
  promos        Promo[]
  discountCards DiscountCard[]
  /// Tickets this user (an AGENT/ADMIN) created on behalf of a client while
  /// signed in — separate from `tickets`, which is ticket ownership.
  bookedTickets Ticket[]       @relation("BookedTickets")

  @@index([role])
  @@index([referredByUserId])
  @@map("users")
}

/// A persistent, reusable discount card — unlike Promo (single campaign
/// code, often time/usage-limited), a card is issued once to a customer
/// (manually by an admin, or as a referral reward/welcome gift) and applies
/// its percent discount to every booking that redeems it, indefinitely.
model DiscountCard {
  id        String  @id @default(cuid())
  code      String  @unique
  /// Fraction 0..1, e.g. 0.10 for -10%.
  percent   Float
  isActive  Boolean @default(true)
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// How this card was issued: "MANUAL" (admin), "REFERRAL_WELCOME" (given
  /// to a new user who signed up with a referral code), "REFERRAL_REWARD"
  /// (given to the referrer after their friend's first booking).
  source    String  @default("MANUAL")
  usedCount Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([isActive])
  @@map("discount_cards")
}

/// A promo code that can be applied to a booking to get a percentage discount.
/// Supports a validity window, a usage cap, and optional binding to a single
/// user account.
model Promo {
  id         String    @id @default(cuid())
  code       String    @unique
  type       PromoType @default(PERCENT)
  /// For PERCENT: fraction 0..1, e.g. 0.10 for -10% (mirrored by `percent`
  /// for backwards compatibility). For FIXED: flat EUR amount (e.g. 5.00).
  percent    Float
  amount     Float?
  label      String?
  isActive   Boolean   @default(true)
  startsAt   DateTime?
  endsAt     DateTime?
  /// Max total redemptions across all users. null = unlimited.
  usageLimit Int?
  usedCount  Int       @default(0)
  /// When set, only this user may redeem the code.
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([userId])
  @@map("promos")
}

model Carrier {
  id        String   @id @default(cuid())
  name      String   @unique
  rating    Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trips  Trip[]
  routes Route[]

  @@map("carriers")
}

/// A reusable route template ("Виїзд №N" in the admin constructor): a
/// from→to schedule with a fixed set of intermediate stops, days of the week
/// it runs on, base price and bus capacity. Concrete `Trip` rows for actual
/// calendar dates are generated from active routes by
/// `lib/routes/generate.ts` (`ensureUpcomingTrips`) — a route is the
/// template, a trip is one dated departure of it.
model Route {
  id            String   @id @default(cuid())
  /// Internal label shown in the admin list, e.g. "Vinnytsia — Sevilla".
  name          String
  fromCity      String
  toCity        String
  carrierId     String
  carrier       Carrier  @relation(fields: [carrierId], references: [id], onDelete: Restrict)
  /// Local departure time of the first stop, "HH:MM".
  departureTime String
  /// Comma-separated ISO weekdays this route runs on (1=Monday..7=Sunday).
  daysOfWeek    String
  basePrice     Float
  busCapacity   Int      @default(45)
  busType       String   @default("Autobus")
  /// Comma-separated amenity labels shown on the trip card, e.g. "Wi-Fi,USB,A/C".
  amenities     String   @default("")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  stops RouteStop[]
  trips Trip[]

  @@index([fromCity, toCity])
  @@index([isActive])
  @@map("routes")
}

/// One stop along a Route, in order. `offsetMinutes` is minutes after the
/// route's `departureTime` that the bus reaches this stop — used both to
/// display the itinerary and to compute each concrete Trip's stop times.
model RouteStop {
  id            String  @id @default(cuid())
  routeId       String
  route         Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  order         Int
  city          String
  address       String?
  offsetMinutes Int     @default(0)
  isPickup      Boolean @default(true)
  isDropoff     Boolean @default(true)

  @@index([routeId, order])
  @@map("route_stops")
}

model Trip {
  id            String   @id @default(cuid())
  fromCity      String
  toCity        String
  departureTime DateTime
  arrivalTime   DateTime
  price         Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  carrierId String
  carrier   Carrier @relation(fields: [carrierId], references: [id], onDelete: Restrict)

  /// Set when this trip was generated from a Route template. Null for
  /// legacy / carrier-adapter trips that don't come from a template.
  routeId String?
  route   Route?  @relation(fields: [routeId], references: [id], onDelete: SetNull)

  tickets Ticket[]
  seats   Seat[]

  @@index([fromCity, toCity, departureTime])
  @@index([carrierId])
  @@index([routeId])
  @@map("trips")
}

/// Real seat inventory for a Trip, generated alongside it (1..route.busCapacity).
/// Booking a ticket claims one row here via a conditional update
/// (`status: AVAILABLE -> BOOKED` guarded by the current status), which is
/// what actually prevents double-booking / overbooking a trip — the mock
/// `seatsLeft` on generated trips before this model existed was never
/// enforced.
model Seat {
  id       String     @id @default(cuid())
  tripId   String
  trip     Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  number   Int
  row      Int
  side     String
  position String
  status   SeatStatus @default(AVAILABLE)

  ticketId String? @unique
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@unique([tripId, number])
  @@index([tripId, status])
  @@map("seats")
}

model Ticket {
  id         String       @id @default(cuid())
  status     TicketStatus @default(RESERVED)
  basePrice  Float
  /// The charged price after age + promo discounts. Stored under the existing
  /// `price` column so older rows keep working after the rename.
  finalPrice Float        @map("price")
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Set when an AGENT/ADMIN created this ticket on the client's behalf
  /// (e.g. a phone/walk-in booking) rather than the client booking it
  /// themselves — `userId` above still owns the ticket. Null for
  /// self-service bookings.
  bookedByUserId   String?
  bookedBy         User?          @relation("BookedTickets", fields: [bookedByUserId], references: [id], onDelete: SetNull)
  /// Snapshot of bookedBy's commission on this ticket at booking time (so a
  /// later change to the agent's rate doesn't rewrite past reports). Null
  /// when bookedByUserId is null or the agent had no commission configured.
  commissionAmount Float?
  /// Who actually collected payment — set by staff via /staff/tickets, null
  /// until then. See the PaymentMethod enum doc comment.
  paymentMethod    PaymentMethod?

  tripId String?
  trip   Trip?   @relation(fields: [tripId], references: [id], onDelete: SetNull)

  booking Booking?
  history TicketHistory[]
  seat    Seat?

  @@index([userId])
  @@index([status])
  @@index([tripId])
  @@index([bookedByUserId])
  @@map("tickets")
}

/// Audit trail for tickets. Every mutation must append a row with:
///   - the actor (`changedBy`, user id; null for system actions)
///   - what they did (`action`)
///   - where it came from (`source`: BOOKING_FORM | ADMIN_PANEL | ACCOUNT | API | SYSTEM)
///   - the full diff of changed fields (`changes`, JSON string: { field: { from, to } })
///   - request metadata for forensic / compliance lookups (ipAddress, userAgent)
///   - precise wall-clock timestamp
///
/// `oldStatus` / `newStatus` remain convenient columns for fast filtering
/// of status transitions without having to parse `changes`.
model TicketHistory {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  action    String
  oldStatus TicketStatus?
  newStatus TicketStatus?
  /// JSON-encoded diff: { "<field>": { "from": <any|null>, "to": <any> } }
  changes   String?
  /// Origin of the change. Known values are enforced at the application level.
  source    String?
  changedBy String?
  ipAddress String?
  userAgent String?
  timestamp DateTime      @default(now())

  @@index([ticketId])
  @@index([changedBy])
  @@index([timestamp])
  @@index([source])
  @@map("ticket_history")
}

model Booking {
  id               String      @id @default(cuid())
  reference        String      @unique
  firstName        String
  lastName         String
  ageCategory      AgeCategory @default(ADULT)
  phone            String
  email            String?
  promoCode        String?
  /// Discount card code redeemed for this booking, if any (mutually
  /// exclusive with promoCode — see lib/discountCards.ts).
  discountCardCode String?
  finalPrice       Float
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  ticketId String @unique
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([reference])
  @@map("bookings")
}
