// Asol BUS — Prisma schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  PARTNER
  DRIVER
  DISPATCHER
  CALL_CENTER
  ACCOUNTANT
  AGENT
  MANAGER
  ADMIN
  SUPER_ADMIN
}

enum TicketStatus {
  RESERVED
  AWAITING_PAYMENT
  PAID_ONLINE
  PAID_CASH
  CANCELLED
  REFUNDED
}

enum AgeCategory {
  CHILD_0_4
  CHILD_5_12
  ADULT
  SENIOR_60
}

enum PromoType {
  PERCENT
  FIXED
}

enum TripKind {
  ONE_WAY
  ROUND_TRIP
  OPEN_RETURN
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  displayName String?
  avatarUrl   String?
  role      Role     @default(CUSTOMER)
  /// Agent-only operational grants. Admins always have these capabilities.
  canEditDepartures Boolean @default(false)
  canHideStops      Boolean @default(false)
  canHideSeats      Boolean @default(false)
  /// JSON array of preferred notification channels: email, sms, viber, telegram, push.
  notifyChannels String @default("[\"email\",\"push\"]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets Ticket[]
  promos  Promo[]

  @@index([role])
  @@map("users")
}

/// A promo code that can be applied to a booking to get a percentage discount.
/// Supports a validity window, a usage cap, and optional binding to a single
/// user account.
model Promo {
  id         String    @id @default(cuid())
  code       String    @unique
  type       PromoType @default(PERCENT)
  /// For PERCENT: fraction 0..1, e.g. 0.10 for -10% (mirrored by `percent`
  /// for backwards compatibility). For FIXED: flat EUR amount (e.g. 5.00).
  percent    Float
  amount     Float?
  label      String?
  isActive   Boolean   @default(true)
  startsAt   DateTime?
  endsAt     DateTime?
  /// Max total redemptions across all users. null = unlimited.
  usageLimit Int?
  usedCount  Int       @default(0)
  /// When set, only this user may redeem the code.
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([userId])
  @@map("promos")
}

model Carrier {
  id        String   @id @default(cuid())
  name      String   @unique
  rating    Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trips Trip[]

  @@map("carriers")
}

model Trip {
  id            String   @id @default(cuid())
  fromCity      String
  toCity        String
  departureTime DateTime
  arrivalTime   DateTime
  price         Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  carrierId String
  carrier   Carrier @relation(fields: [carrierId], references: [id], onDelete: Restrict)

  tickets       Ticket[]
  returnTickets Ticket[] @relation("ReturnTrip")
  seatHolds     SeatHold[]

  departureId String?
  departure   Departure? @relation(fields: [departureId], references: [id], onDelete: SetNull)

  @@index([fromCity, toCity, departureTime])
  @@index([carrierId])
  @@index([departureId])
  @@map("trips")
}

model Ticket {
  id         String       @id @default(cuid())
  status     TicketStatus @default(RESERVED)
  basePrice  Float
  /// The charged price after age + promo discounts. Stored under the existing
  /// `price` column so older rows keep working after the rename.
  finalPrice Float        @map("price")
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tripId String?
  trip   Trip?   @relation(fields: [tripId], references: [id], onDelete: SetNull)

  /// Coach seat number (1…) when the departure assigns seats.
  seatNumber Int?
  /// Segment of the route (stop indices within the departure); null = full route.
  fromStopIndex Int?
  toStopIndex   Int?
  /// Segment cities as sold (fallback to the trip's endpoints).
  fromCity String?
  toCity   String?
  tripKind   TripKind @default(ONE_WAY)
  returnTripId String?
  returnTrip   Trip?   @relation("ReturnTrip", fields: [returnTripId], references: [id], onDelete: SetNull)
  returnSeatNumber Int?

  /// Optimistic concurrency control: increments on every mutation. Writers
  /// must match the version they read, otherwise the update fails (P2025)
  /// and the caller retries with fresh state.
  version    Int          @default(0)

  booking Booking?
  history TicketHistory[]
  payments Payment[]

  @@index([userId])
  @@index([status])
  @@index([tripId])
  @@index([returnTripId])
  @@map("tickets")
}

/// Audit trail for tickets. Every mutation must append a row with:
///   - the actor (`changedBy`, user id; null for system actions)
///   - what they did (`action`)
///   - where it came from (`source`: BOOKING_FORM | ADMIN_PANEL | ACCOUNT | API | SYSTEM)
///   - the full diff of changed fields (`changes`, JSON string: { field: { from, to } })
///   - request metadata for forensic / compliance lookups (ipAddress, userAgent)
///   - precise wall-clock timestamp
///
/// `oldStatus` / `newStatus` remain convenient columns for fast filtering
/// of status transitions without having to parse `changes`.
model TicketHistory {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  action    String
  oldStatus TicketStatus?
  newStatus TicketStatus?
  /// JSON-encoded diff: { "<field>": { "from": <any|null>, "to": <any> } }
  changes   String?
  /// Origin of the change. Known values are enforced at the application level.
  source    String?
  changedBy String?
  ipAddress String?
  userAgent String?
  timestamp DateTime      @default(now())

  @@index([ticketId])
  @@index([changedBy])
  @@index([timestamp])
  @@index([source])
  @@map("ticket_history")
}

/// Temporary lock on a coach seat while a booking session is in progress,
/// so two passengers cannot book the same seat at the same time.
/// Expires automatically; the booking API consumes it on success.
model SeatHold {
  id         String   @id @default(cuid())
  tripId     String
  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  seatNumber Int
  /// Segment the hold covers; null = full route.
  fromStopIndex Int?
  toStopIndex   Int?
  /// Anonymous browser-session id generated by the booking form.
  sessionId  String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@unique([tripId, seatNumber])
  @@index([expiresAt])
  @@index([sessionId])
  @@map("seat_holds")
}

enum PaymentStatus {
  PENDING
  SENT
  SETTLED
  EXPIRED
  CANCELLED
}

/// Online payment attempt for a ticket. The ticket is created with status
/// AWAITING_PAYMENT; the payment must be sent within `deadlineAt` (24 h by
/// default, otherwise the online discount is lost) and is reconciled after
/// `settleAfter` (20–30 min settlement window of the payment system).
model Payment {
  id          String        @id @default(cuid())
  ticketId    String
  ticket      Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  status      PaymentStatus @default(PENDING)
  /// Discounted amount the passenger pays online.
  amount      Float
  /// Price without the online discount (restored if the deadline passes).
  fullAmount  Float
  provider    String        @default("MOCK")
  providerRef String?
  /// When the passenger confirmed the payment in the payment system.
  sentAt      DateTime?
  /// Funds are expected to arrive after this moment (settle window).
  settleAfter DateTime?
  /// Pay-before deadline; afterwards the online discount expires.
  deadlineAt  DateTime
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([ticketId])
  @@index([status])
  @@map("payments")
}

/// Key-value site settings (online discount, payment windows, seat holds).
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

/// Editable per-role permission grant (booking.read, payment.refund, …).
model RolePermission {
  id         String @id @default(cuid())
  role       Role
  permission String
  allowed    Boolean @default(true)

  @@unique([role, permission])
  @@map("role_permissions")
}

/// Fleet bus with an editable seat layout (FUTABUS-style: decks, cell
/// types, sleeper kinds, per-seat price multiplier).
model Bus {
  id        String   @id @default(cuid())
  plate     String   @unique
  model     String?
  decks     Int      @default(1)
  /// JSON CoachLayout — see lib/seats.ts. Empty = default 46-seat coach.
  layout    String   @default("")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departures Departure[]

  @@map("buses")
}

/// Per-event notification rule: which roles get which alert, and the
/// threshold (e.g. minutes unpaid) where relevant.
model NotificationRule {
  kind         String  @id
  enabled      Boolean @default(true)
  /// JSON array of Role values.
  roles        String  @default("[]")
  thresholdMin Int?
  updatedAt    DateTime @updatedAt

  @@map("notification_rules")
}

/// Notification Center entry. `userId` targets one user; `role` broadcasts
/// to every user of that role (read state is per row for role broadcasts —
/// first reader marks it; for the demo this is acceptable).
model Notification {
  id        String    @id @default(cuid())
  userId    String?
  role      Role?
  kind      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([role, readAt])
  @@index([createdAt])
  @@map("notifications")
}

/// Flexible tariff grid per country: one grid covers all routes and
/// departures of that country. Final price = tier price (by sold seat
/// share) × month multiplier × time phase (early-bird / last-minute),
/// clamped to [minPrice, maxPrice].
model TariffGrid {
  id          String  @id @default(cuid())
  countryId   String  @unique
  country     Country @relation(fields: [countryId], references: [id], onDelete: Cascade)
  /// Coach capacity the shares are computed against.
  capacity    Int     @default(46)
  /// JSON array: [{ "share": 0.5, "price": 40 }, ...] — shares sum to 1.
  tiers       String  @default("[]")
  /// JSON object: { "1": 1.2, "10": 0.85 } — month number (1–12) → multiplier.
  monthMultipliers String @default("{}")
  /// Days before departure from which the early-bird discount applies.
  earlyBirdDays    Int?
  earlyBirdPercent Float?
  /// Days before departure from which the last-minute surcharge applies.
  lastMinuteDays    Int?
  lastMinutePercent Float?
  minPrice Float?
  maxPrice Float?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tariff_grids")
}

model Booking {
  id          String      @id @default(cuid())
  reference   String      @unique
  /// Shared reference for multi-passenger purchases (equals the first
  /// booking's reference). Null for single-passenger bookings.
  groupRef    String?
  firstName   String
  lastName    String
  ageCategory AgeCategory @default(ADULT)
  phone       String
  email       String?
  promoCode   String?
  finalPrice  Float
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  ticketId String @unique
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([reference])
  @@index([groupRef])
  @@map("bookings")
}

/// Destination country used to group route templates in the admin UI.
model Country {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String?  @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  templates       RouteTemplate[] @relation("RouteDestinationCountry")
  originTemplates RouteTemplate[] @relation("RouteOriginCountry")
  tariffGrid      TariffGrid?

  @@map("countries")
}

/// Reusable schedule template for regular departures ("шаблон маршруту").
model RouteTemplate {
  id          String  @id @default(cuid())
  countryId   String
  country     Country @relation("RouteDestinationCountry", fields: [countryId], references: [id], onDelete: Restrict)
  originCountryId String?
  originCountry   Country? @relation("RouteOriginCountry", fields: [originCountryId], references: [id], onDelete: Restrict)
  name        String
  originCity  String
  destinationCity String
  /// JSON array of ISO weekdays 1=Mon … 7=Sun, e.g. "[2,4]" for Tue+Thu.
  departureWeekdays String @default("[]")
  busPhone          String?
  dispatcherPhone   String?
  /// Weekday the outbound leaves Ukraine (1–7).
  ukraineDepartureWeekday Int?
  /// Weekday the return arrives back in Ukraine (1–7).
  ukraineReturnWeekday    Int?
  defaultBus String?
  comment    String?
  /// When false, generated departures sell tickets without a seat number.
  hasAssignedSeats Boolean @default(true)
  /// When false, generated departures sell only endpoint-to-endpoint.
  allowSegmentSales Boolean @default(true)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  stops      RouteTemplateStop[]
  departures Departure[]

  @@index([countryId])
  @@index([originCountryId])
  @@index([isActive])
  @@map("route_templates")
}

model RouteTemplateStop {
  id               String        @id @default(cuid())
  templateId       String
  template         RouteTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sortOrder        Int
  city             String
  /// 1-based day along the outbound journey (routes can last 2–5+ days).
  outboundDay      Int
  outboundTime     String
  returnDay        Int
  returnTime       String
  addressLabel     String?
  boardingAddress  String?
  latitude         Float?
  longitude        Float?
  visibleByDefault Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  departureStops DepartureStop[]

  @@unique([templateId, sortOrder])
  @@index([templateId])
  @@map("route_template_stops")
}

/// A concrete calendar run generated from a template ("виїзд").
model Departure {
  id                      String        @id @default(cuid())
  templateId              String
  template                RouteTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  /// UTC midnight of the Ukraine outbound date.
  date                    DateTime
  weekday                 Int
  busPhone                String?
  dispatcherPhone         String?
  defaultBus              String?
  /// Assigned bus from the fleet (drives the seat layout).
  busId                   String?
  bus                     Bus?            @relation(fields: [busId], references: [id], onDelete: SetNull)
  comment                 String?
  ukraineDepartureWeekday Int?
  ukraineReturnWeekday    Int?
  /// When false, tickets on this run have no seat assignment.
  hasAssignedSeats        Boolean       @default(true)
  /// When true, seats can be sold per segment (Київ→Львів, Львів→Берлін…).
  allowSegmentSales       Boolean       @default(true)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  stops DepartureStop[]
  trips Trip[]

  @@unique([templateId, date])
  @@index([date])
  @@index([templateId])
  @@map("departures")
}

model DepartureStop {
  id              String             @id @default(cuid())
  departureId     String
  departure       Departure          @relation(fields: [departureId], references: [id], onDelete: Cascade)
  templateStopId  String?
  templateStop    RouteTemplateStop? @relation(fields: [templateStopId], references: [id], onDelete: SetNull)
  sortOrder       Int
  city            String
  outboundDay     Int
  outboundTime    String
  returnDay       Int
  returnTime      String
  addressLabel    String?
  boardingAddress String?
  latitude        Float?
  longitude       Float?
  /// Shown in itinerary / ticket. Hidden cities stay on the run for ops.
  isVisible       Boolean            @default(true)
  /// When false, this city is not offered for sale (seats hidden).
  saleEnabled     Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([departureId, sortOrder])
  @@index([departureId])
  @@index([templateStopId])
  @@map("departure_stops")
}
