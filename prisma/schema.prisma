// Asol BUS — Prisma schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  AGENT
  ADMIN
  SUPER_ADMIN
}

enum TicketStatus {
  RESERVED
  PAID_ONLINE
  PAID_CASH
  CANCELLED
  REFUNDED
}

enum AgeCategory {
  CHILD_0_4
  CHILD_5_12
  ADULT
  SENIOR_60
}

enum PromoType {
  PERCENT
  FIXED
}

enum TransportType {
  BUS
  FLIGHT
  TRAIN
}

enum SettlementStatus {
  GENERATED
  SENT
  PAID
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      Role     @default(USER)
  /// Agent permission granted by an admin on the Users tab: when true, the
  /// agent console shows tickets of ALL passengers; when false, the agent
  /// sees only tickets booked under their own account.
  canViewAllTickets Boolean @default(false)
  /// Agent permission granted by an admin on the Users tab: when true, the
  /// agent may edit passenger details on ANY ticket; when false, only on
  /// tickets booked under their own account. Owners can always edit their
  /// own passenger data; admins can always edit everything.
  canEditAllTickets Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets Ticket[]
  promos  Promo[]

  @@index([role])
  @@map("users")
}

/// A promo code that can be applied to a booking to get a percentage discount.
/// Supports a validity window, a usage cap, and optional binding to a single
/// user account.
model Promo {
  id         String    @id @default(cuid())
  code       String    @unique
  type       PromoType @default(PERCENT)
  /// For PERCENT: fraction 0..1, e.g. 0.10 for -10% (mirrored by `percent`
  /// for backwards compatibility). For FIXED: flat EUR amount (e.g. 5.00).
  percent    Float
  amount     Float?
  label      String?
  isActive   Boolean   @default(true)
  startsAt   DateTime?
  endsAt     DateTime?
  /// Max total redemptions across all users. null = unlimited.
  usageLimit Int?
  usedCount  Int       @default(0)
  /// When set, only this user may redeem the code.
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([userId])
  @@map("promos")
}

model Carrier {
  id        String   @id @default(cuid())
  name      String   @unique
  rating    Float    @default(0)
  /// Default agency commission, percent 0..100, applied to ticket sales when
  /// no route-specific CommissionRule matches.
  commissionPercent Float @default(10)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trips           Trip[]
  commissionRules CommissionRule[]
  settlements     Settlement[]

  @@map("carriers")
}

/// Route-specific commission override: what percentage of each sold ticket
/// the agency keeps for this carrier on this exact route (fromCity → toCity).
/// The remainder is payable to the carrier in the monthly settlement.
model CommissionRule {
  id       String @id @default(cuid())
  fromCity String
  toCity   String
  /// Agency commission, percent 0..100 (e.g. 20 = agency keeps 20%).
  percent  Float

  carrierId String
  carrier   Carrier @relation(fields: [carrierId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([carrierId, fromCity, toCity])
  @@map("commission_rules")
}

model Trip {
  id            String   @id @default(cuid())
  fromCity      String
  toCity        String
  departureTime DateTime
  arrivalTime   DateTime
  price         Float
  transportType TransportType @default(BUS)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  carrierId String
  carrier   Carrier @relation(fields: [carrierId], references: [id], onDelete: Restrict)

  tickets Ticket[]

  @@index([fromCity, toCity, departureTime])
  @@index([carrierId])
  @@map("trips")
}

model Ticket {
  id         String       @id @default(cuid())
  status     TicketStatus @default(RESERVED)
  basePrice  Float
  /// The charged price after age + promo discounts. Stored under the existing
  /// `price` column so older rows keep working after the rename.
  finalPrice Float        @map("price")
  /// Commission snapshot captured at booking time (never recomputed later, so
  /// changing commission rules does not rewrite history):
  ///   commissionAmount = finalPrice * commissionPercent / 100  (agency keeps)
  ///   carrierAmount    = finalPrice - commissionAmount         (owed to carrier)
  commissionPercent Float?
  commissionAmount  Float?
  carrierAmount     Float?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tripId String?
  trip   Trip?   @relation(fields: [tripId], references: [id], onDelete: SetNull)

  /// Set once the ticket is included in a monthly settlement invoice.
  settlementId String?
  settlement   Settlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)

  booking Booking?
  history TicketHistory[]

  @@index([userId])
  @@index([status])
  @@index([tripId])
  @@index([settlementId])
  @@map("tickets")
}

/// Monthly settlement with a carrier: aggregates all tickets sold in the
/// period, the agency commission and the net balance direction.
/// One settlement per carrier per period (YYYY-MM).
///
/// Payment point matters: for tickets paid ONLINE the money sits with the
/// agency (we owe the carrier its share); for tickets paid CASH to the
/// carrier the money sits with the carrier (it owes us the commission).
/// The net balance is stored as balanceAmount + balanceDirection.
model Settlement {
  id           String           @id @default(cuid())
  /// Period in YYYY-MM format (calendar month the sales belong to).
  period       String
  ticketCount  Int
  /// Sum of ticket finalPrice (what passengers paid, before our service fee).
  grossAmount  Float
  /// Agency earnings: sum of ticket commissionAmount.
  commissionAmount Float
  /// Carrier share: sum of ticket carrierAmount.
  carrierAmount    Float
  /// Gross collected by the agency (tickets PAID_ONLINE).
  collectedByAgent   Float @default(0)
  /// Gross collected by the carrier (tickets PAID_CASH).
  collectedByCarrier Float @default(0)
  /// Gross not yet paid by passengers (tickets RESERVED).
  unpaidAmount       Float @default(0)
  /// Net balance, absolute value. Direction in balanceDirection:
  ///   TO_CARRIER — agency must pay the carrier this amount
  ///   TO_AGENT   — carrier must pay the agency this amount
  ///   ZERO       — nothing owed
  balanceAmount    Float  @default(0)
  balanceDirection String @default("TO_CARRIER")
  status       SettlementStatus @default(GENERATED)
  /// Sequential invoice number, e.g. INV-2026-08-0001.
  invoiceNumber String          @unique
  actNumber    String?
  sentAt       DateTime?
  paidAt       DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  carrierId String
  carrier   Carrier @relation(fields: [carrierId], references: [id], onDelete: Restrict)

  tickets Ticket[]
  events  SettlementEvent[]

  @@unique([carrierId, period])
  @@index([period])
  @@map("settlements")
}

/// Audit trail of everything that happened to a settlement: generation,
/// sending, payment. Answers "was this report calculated/sent/paid, by whom
/// and when" without parsing logs.
model SettlementEvent {
  id           String   @id @default(cuid())
  /// GENERATED | SENT | PAID
  action       String
  /// Who did it: user email, or "cron" for the monthly job.
  actor        String?
  /// Optional JSON details (amounts at the time, etc.).
  details      String?
  createdAt    DateTime @default(now())

  settlementId String
  settlement   Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@index([settlementId])
  @@index([createdAt])
  @@map("settlement_events")
}

/// Audit trail for tickets. Every mutation must append a row with:
///   - the actor (`changedBy`, user id; null for system actions)
///   - what they did (`action`)
///   - where it came from (`source`: BOOKING_FORM | ADMIN_PANEL | ACCOUNT | API | SYSTEM)
///   - the full diff of changed fields (`changes`, JSON string: { field: { from, to } })
///   - request metadata for forensic / compliance lookups (ipAddress, userAgent)
///   - precise wall-clock timestamp
///
/// `oldStatus` / `newStatus` remain convenient columns for fast filtering
/// of status transitions without having to parse `changes`.
model TicketHistory {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  action    String
  oldStatus TicketStatus?
  newStatus TicketStatus?
  /// JSON-encoded diff: { "<field>": { "from": <any|null>, "to": <any> } }
  changes   String?
  /// Origin of the change. Known values are enforced at the application level.
  source    String?
  changedBy String?
  ipAddress String?
  userAgent String?
  timestamp DateTime      @default(now())

  @@index([ticketId])
  @@index([changedBy])
  @@index([timestamp])
  @@index([source])
  @@map("ticket_history")
}

model Booking {
  id          String      @id @default(cuid())
  reference   String      @unique
  firstName   String
  lastName    String
  ageCategory AgeCategory @default(ADULT)
  phone       String
  email       String?
  promoCode   String?
  finalPrice  Float
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  ticketId String @unique
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([reference])
  @@map("bookings")
}
